{
  "version": 2,
  "builds": [
    {
      "src": "src/server.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["src/db/migrations/**"],
        "maxDuration": 60
      }
    }
  ],
  "crons": [
    {
      "path": "/api/command-center/sync-cron",
      "schedule": "0 4 * * *"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/server.ts"
    }
  ]
}
