# Cognecto Cortex-W — environment reference
# Copy relevant portions into backend/.env and frontend/.env as needed.
# Never commit a real .env file. No secret in this file is real.

# ---------------------------------------------------------------------------
# BACKEND (Cortex-W BFF)
# ---------------------------------------------------------------------------
PORT=4000

# seed  = serve everything from local Postgres seed tables
# api   = proxy/adapt every call to the real upstream backend
# hybrid= per-module switch (see backend/src/config/dataMode.ts)
APP_DATA_MODE=seed

DATABASE_URL=postgres://cortex_w:cortex_w_local_dev@localhost:55432/cortex_w

# The existing water-meter backend (source of truth once APP_DATA_MODE=api)
UPSTREAM_API_BASE_URL=http://localhost:8080/api
UPSTREAM_DATA_REST_URL=http://localhost:8080

# Used only for locally-issued demo JWTs in seed mode. In api mode the real
# upstream JWT is passed through untouched (read from Authorization or
# Jwt-Token response header, never re-signed).
JWT_LOCAL_SIGNING_SECRET=change-me-in-real-deployment

# Matches the existing backend's meter-health freshness window (section 23.2
# of the foundation spec). Configurable, but do not silently redefine it.
SEED_FRESHNESS_HOURS=36

CORS_ORIGIN=http://localhost:8088

# ---------------------------------------------------------------------------
# FRONTEND (Cortex-W SPA)
# ---------------------------------------------------------------------------
# Consumed at container start by public/runtime-config.js, NOT compiled into
# the Vite bundle. This lets one built image move between environments.
APP_DATA_MODE=seed
API_BASE_URL=http://localhost:4000/api
GOOGLE_MAPS_API_KEY=
SHOW_DEMO_AUTH=true
ENABLE_HYDRAULIC_SEED=true
